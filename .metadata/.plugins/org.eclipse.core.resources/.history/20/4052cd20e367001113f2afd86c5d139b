package com.ids.core;

import com.ids.models.PacketContext;
import org.pcap4j.packet.*;
import org.pcap4j.packet.namednumber.IcmpV4Type;

public class PacketParser {

    public static PacketContext parse(Packet packet) {
        PacketContext ctx = new PacketContext();
        ctx.setTimestamp(System.currentTimeMillis());

        try {
            // ETHERNET — MAC addresses
            EthernetPacket eth = packet.get(EthernetPacket.class);
            if (eth != null) {
                ctx.setSrcMac(eth.getHeader().getSrcAddr().toString());
                ctx.setDstMac(eth.getHeader().getDstAddr().toString());
            } else {
                ctx.setSrcMac("");
                ctx.setDstMac("");
            }
            // IP — use getHostAddress(), NOT toString()
            // toString() returns "/192.168.8.50" — the leading slash breaks
            // every string comparison downstream including whitelist checks
            IpV4Packet ip = packet.get(IpV4Packet.class);
            if (ip != null) {
                ctx.setSrcIp(ip.getHeader().getSrcAddr().getHostAddress());
                ctx.setDstIp(ip.getHeader().getDstAddr().getHostAddress());
            }

            // TCP
            TcpPacket tcp = packet.get(TcpPacket.class);
            if (tcp != null) {
                ctx.setProtocol("TCP");
                ctx.setSrcPort(tcp.getHeader().getSrcPort().valueAsInt());
                ctx.setDstPort(tcp.getHeader().getDstPort().valueAsInt());
                ctx.setSyn(tcp.getHeader().getSyn());
                ctx.setAck(tcp.getHeader().getAck());
                ctx.setFin(tcp.getHeader().getFin());
                ctx.setRst(tcp.getHeader().getRst());
                ctx.setPsh(tcp.getHeader().getPsh());
                ctx.setUrg(tcp.getHeader().getUrg());
                return ctx;
            }

            // UDP
            UdpPacket udp = packet.get(UdpPacket.class);
            if (udp != null || udp.getPayload() != null ) {
                ctx.setProtocol("UDP");
                ctx.setSrcPort(udp.getHeader().getSrcPort().valueAsInt());
                ctx.setDstPort(udp.getHeader().getDstPort().valueAsInt());
                ctx.setPayloadLength(udp.getPayload().getRawData().length);
                return ctx;
            }
           

            // ICMP
            IcmpV4CommonPacket icmp = packet.get(IcmpV4CommonPacket.class);
            if (icmp != null) {
                ctx.setProtocol("ICMP");
                if (icmp.getHeader().getType().equals(IcmpV4Type.ECHO)) {
                    ctx.setIcmpEchoRequest(true);
                }
                
                return ctx;
            }

            // ARP — getHostAddress() here too
            ArpPacket arp = packet.get(ArpPacket.class);
            if (arp != null) {
                ctx.setProtocol("ARP");
                ctx.setSrcIp(arp.getHeader().getSrcProtocolAddr().getHostAddress());
                ctx.setDstIp(arp.getHeader().getDstProtocolAddr().getHostAddress());
                ctx.setSrcMac(arp.getHeader().getSrcHardwareAddr().toString());
                ctx.setDstMac(arp.getHeader().getDstHardwareAddr().toString());
                return ctx;
            }

        } catch (Exception ignored) {}

        return ctx;
    }
}