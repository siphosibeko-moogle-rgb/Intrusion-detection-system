FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

RUN apt-get update \
    && apt-get install -y libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the thin jar
COPY engine/target/engine-1.0.0.jar engine-1.0.0.jar

# Copy all dependency jars — required because manifest Class-Path points here
COPY engine/target/libs/ libs/

CMD ["java", "-jar", "engine-1.0.0.jar", "eth0", "http://ids_backend:8080"]
