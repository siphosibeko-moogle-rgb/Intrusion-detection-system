package com.ids.desktop.controller;

import com.fasterxml.jackson.databind.JsonNode;
import com.ids.desktop.model.*;
import com.ids.desktop.service.BackendClient;
import javafx.application.Platform;

import java.util.List;
import java.util.function.BiConsumer;
import java.util.function.Consumer;

/**
 * Owns all background data loading.
 * Never touches UI directly — all results are delivered via Platform.runLater().
 * Keeps MainController free of threading boilerplate.
 */
public class DataLoader {

    private final BackendClient backend;

    public DataLoader(BackendClient backend) {
        this.backend = backend;
    }

    public void loadAlerts(Consumer<List<AlertItem>> onAlerts,
                           Consumer<JsonNode> onStats,
                           Consumer<String> onError) {
        thread("ids-load-alerts", () -> {
            try {
                List<AlertItem> items = backend.fetchAlerts();
                JsonNode stats        = backend.fetchStats();
                Platform.runLater(() -> {
                    onAlerts.accept(items);
                    onStats.accept(stats);
                });
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void loadWhitelist(Consumer<List<MyWhitelistItem>>  onMy,
                              Consumer<List<OrgWhitelistItem>> onOrg,
                              Consumer<List<FlaggedIpItem>>    onFlagged,
                              Consumer<String> onError) {
        thread("ids-load-whitelist", () -> {
            try {
                List<MyWhitelistItem>  myItems  = backend.fetchMyWhitelist();
                List<OrgWhitelistItem> orgItems = backend.fetchOrgWhitelist();
                List<FlaggedIpItem>    flagged  = backend.fetchFlaggedIps();
                Platform.runLater(() -> {
                    onMy.accept(myItems);
                    onOrg.accept(orgItems);
                    onFlagged.accept(flagged);
                });
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void loadCases(Consumer<List<CaseItem>> onCases,
                          Consumer<String> onError) {
        thread("ids-load-cases", () -> {
            try {
                List<CaseItem> items = backend.fetchCases();
                Platform.runLater(() -> onCases.accept(items));
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void login(String user, String pass,
                      Runnable onSuccess,
                      Consumer<String> onFailure) {
        thread("ids-login-thread", () -> {
            try {
                boolean ok = backend.login(user, pass);
                Platform.runLater(() -> {
                    if (ok) onSuccess.run();
                    else    onFailure.accept("Invalid credentials");
                });
            } catch (Exception e) {
                Platform.runLater(() -> onFailure.accept(e.getMessage()));
            }
        });
    }

    // Generic fire-and-forget for mutations (add/delete/approve)
    public void submit(String threadName, ThrowingRunnable action,
                       Runnable onSuccess, Consumer<String> onError) {
        thread(threadName, () -> {
            try {
                action.run();
                Platform.runLater(onSuccess);
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    private void thread(String name, Runnable r) {
        Thread t = new Thread(r, name);
        t.setDaemon(true);
        t.start();
    }

    @FunctionalInterface
    public interface ThrowingRunnable {
        void run() throws Exception;
    }
}