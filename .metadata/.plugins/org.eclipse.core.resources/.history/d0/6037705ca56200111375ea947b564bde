    // ATTACKER AGGREGATION
    //
    // WHY we compute this client-side:
    //   The backend could expose a /api/alerts/top-attackers endpoint, but for
    //   now we have the full alert list in memory.  Group by sourceIp, count
    //   occurrences, sort descending, take top 20.  For alert volumes up to
    //   ~50k rows this is sub-millisecond — no backend round-trip needed.
    //   Once alert volumes grow, add a dedicated backend endpoint.

    private void rebuildAttackers() {

        // Group allAlerts by (sourceIp, sourceMac), count hits.
        Map<String, Long> counts = allAlerts.stream()
                .filter(a -> a.getSourceIp() != null && !a.getSourceIp().isEmpty())
                .collect(Collectors.groupingBy(AlertItem::getSourceIp, Collectors.counting()));

        // Build synthetic AlertItem rows where packetCount = hit count.
        List<AlertItem> top = counts.entrySet().stream()
                .sorted(Map.Entry.<String, Long>comparingByValue().reversed())
                .limit(20)
                .map(e -> {
                    // Find the first alert for this IP to get the MAC address.
                    String mac = allAlerts.stream()
                            .filter(a -> e.getKey().equals(a.getSourceIp()))
                            .map(AlertItem::getSourceMac)
                            .findFirst()
                            .orElse("");
                    return new AlertItem(
                            "", "",                    // timestamp, severity — not shown
                            "",                         // threatType
                            e.getKey(),                 // sourceIp
                            mac,                        // sourceMac
                            "", "", "",                 // destIp, protocol, requestType
                            e.getValue().intValue(),    // packetCount reused as hit count
                            ""
                    );
                })
                .collect(Collectors.toList());

        attackers.setAll(top);
    }
    // STATS BAR UPDATE

    private void updateStats(JsonNode stats) {
        // The /api/alerts/stats endpoint returns:
        //   {"total":42, "critical":3, "high":10, "medium":15, "low":14}
        // If the backend doesn't have that endpoint yet, fall back to counting
        // from the in-memory list.  Either way the UI stays correct.
        if (stats != null && stats.has("total")) {
            lblTotal.setText(String.valueOf(stats.path("total").asInt()));
            lblCritical.setText(String.valueOf(stats.path("critical").asInt()));
            lblHigh.setText(String.valueOf(stats.path("high").asInt()));
            lblMedium.setText(String.valueOf(stats.path("medium").asInt()));
        } else {
            // Fallback: count from local list.
            lblTotal.setText(String.valueOf(allAlerts.size()));
            lblCritical.setText(String.valueOf(allAlerts.stream()
                    .filter(a -> "CRITICAL".equals(a.getSeverity())).count()));
            lblHigh.setText(String.valueOf(allAlerts.stream()
                    .filter(a -> "HIGH".equals(a.getSeverity())).count()));
            lblMedium.setText(String.valueOf(allAlerts.stream()
                    .filter(a -> "MEDIUM".equals(a.getSeverity())).count()));
        }
    }

    // LIVE FEED (WEBSOCKET)

    private void startLiveFeed() {
        try {
            String wsUrl = BACKEND_URL
                    .replace("http://", "ws://")
                    .replace("https://", "wss://")
                    + "/ws/websocket";

            // NOTE: The convenience constructor takes a token String for future
            // STOMP-level auth.  BackendClient doesn't expose getToken() yet, and
            // the /ws endpoint is permit-all in SecurityConfig, so we pass "".
            // When you add WS-level auth: add public String getToken() to BackendClient.
            wsFeed = new LiveFeedClient(
                    wsUrl,
                    "",                     // token — add getToken() to BackendClient later
                    this::onAlertReceived   // Consumer<JsonNode>
            );
            wsFeed.connect();

        } catch (Exception e) {
            System.err.println("[Desktop] WebSocket connect failed: " + e.getMessage());
        }
    }

    /**
     * Called on the WebSocket I/O thread — must not touch UI directly.
     * Platform.runLater() marshals the update onto the JavaFX application thread.
     *
     * WHY we also add to allAlerts here:
     *   This means a new detection appears in BOTH the live feed (timestamped string)
     *   AND the alert table (full row) in real time, without waiting for the next
     *   30-second polling cycle.
     */
    private void onAlertReceived(JsonNode node) {
        String ts       = FMT.format(Instant.now());
        String severity = node.path("severity").asText("?");
        String type     = node.path("threatType").asText("?");
        String srcIp    = node.path("sourceIp").asText("?");

        String entry = String.format("[%s] %s %s from %s", ts, severity, type, srcIp);

        Platform.runLater(() -> {
            // Add to the live feed list (bounded to MAX_LIVE_ENTRIES).
            liveEntries.add(0, entry);
            if (liveEntries.size() > MAX_LIVE_ENTRIES) {
                liveEntries.remove(liveEntries.size() - 1);
            }

            // Also inject the full alert into the table immediately.
            AlertItem item = new AlertItem(
                    ts,
                    severity,
                    type,
                    srcIp,
                    node.path("sourceMac").asText(""),
                    node.path("destIp").asText(""),
                    node.path("protocol").asText(""),
                    node.path("requestType").asText(""),
                    node.path("packetCount").asInt(0),
                    node.path("details").asText("")
            );
            allAlerts.add(0, item);
            rebuildAttackers();

            // Update the stats counter in real time.
            lblTotal.setText(String.valueOf(allAlerts.size()));
        });
    }

    // POLLING
    //
    // WHY poll at all if we have WebSocket:
    //   WebSocket gives us real-time pushes, but if the connection drops and
    //   reconnects, we might miss alerts that arrived during the gap.
    //   The 30-second poll acts as a reconciliation / catch-up mechanism.
    private void startPolling() {
        scheduler.scheduleAtFixedRate(() -> {
            if (isReady()) {
                Platform.runLater(this::loadAlerts);
            }
        }, 30, 30, TimeUnit.SECONDS);
    }

