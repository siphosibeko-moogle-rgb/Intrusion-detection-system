    /**
     * Called by the main application class on window close.
     * Cleanly shuts down background threads so the JVM exits immediately.
     *
     * WHY explicit shutdown:
     *   The scheduler thread is a daemon thread (set in the factory above) so it
     *   will die with the JVM anyway, but explicit shutdown is good practice —
     *   it flushes any pending tasks and avoids a 60-second wait for timeout.
     *   The WebSocket close() sends a proper CLOSE frame to the backend.
     */
    public void shutdown() {
        scheduler.shutdownNow();

        if (wsFeed != null) {
            try { wsFeed.close(); } catch (Exception ignored) {}
        }
    }
