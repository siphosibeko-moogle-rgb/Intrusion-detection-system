    // FILTER SETUP

    private void setupFilters() {

        // Alert table filters — any of the text fields or combos triggers a re-filter.
        tfFilterIp.textProperty().addListener((o, ov, nv)   -> applyAlertFilter());
        tfFilterMac.textProperty().addListener((o, ov, nv)  -> applyAlertFilter());
        tfFilterType.textProperty().addListener((o, ov, nv) -> applyAlertFilter());
        cbFilterSeverity.valueProperty().addListener((o, ov, nv) -> applyAlertFilter());
        cbFilterProtocol.valueProperty().addListener((o, ov, nv) -> applyAlertFilter());

        // Whitelist filter.
        tfFilterWlIp.textProperty().addListener((o, ov, nv) -> applyWlFilter());

        // Cases filter.
        tfCaseFilterStatus.textProperty().addListener((o, ov, nv) -> applyCaseFilter());
        tfCaseFilterIp.textProperty().addListener((o, ov, nv)     -> applyCaseFilter());
    }

    private void applyAlertFilter() {
        String ip       = tfFilterIp.getText().toLowerCase().trim();
        String mac      = tfFilterMac.getText().toLowerCase().trim();
        String type     = tfFilterType.getText().toLowerCase().trim();
        String severity = cbFilterSeverity.getValue();
        String protocol = cbFilterProtocol.getValue();

        filteredAlerts.setPredicate(a -> {
            if (!ip.isEmpty()   && !a.getSourceIp().toLowerCase().contains(ip))       return false;
            if (!mac.isEmpty()  && !a.getSourceMac().toLowerCase().contains(mac))      return false;
            if (!type.isEmpty() && !a.getThreatType().toLowerCase().contains(type))    return false;
            if (severity != null && !severity.isEmpty() && !severity.equals(a.getSeverity())) return false;
            if (protocol != null && !protocol.isEmpty() && !protocol.equals(a.getProtocol()))  return false;
            return true;
        });
    }

    private void applyWlFilter() {
        String f = tfFilterWlIp.getText().toLowerCase();

        filteredMyWl.setPredicate(w ->
                f.isEmpty()
                || w.getIp().toLowerCase().contains(f)
                || (w.getMac() != null && w.getMac().toLowerCase().contains(f))
                || (w.getLabel() != null && w.getLabel().toLowerCase().contains(f)));

        orgAccepted.setPredicate(o ->
                f.isEmpty()
                || o.getIp().toLowerCase().contains(f)
                || (o.getOrgName() != null && o.getOrgName().toLowerCase().contains(f)));

        orgPending.setPredicate(o ->
                f.isEmpty()
                || o.getIp().toLowerCase().contains(f)
                || (o.getOrgName() != null && o.getOrgName().toLowerCase().contains(f)));
    }

    private void applyCaseFilter() {
        String status = tfCaseFilterStatus.getText().toLowerCase().trim();
        String ip     = tfCaseFilterIp.getText().toLowerCase().trim();

        filteredCases.setPredicate(c -> {
            if (!status.isEmpty() && !c.getStatus().toLowerCase().contains(status)) return false;
            if (!ip.isEmpty()     && !c.getSuspectIp().toLowerCase().contains(ip))  return false;
            return true;
        });
    }

    // LOGIN ACTION

    @FXML
    private void onLogin() {

        String user = tfUsername.getText().trim();
        String pass = pfPassword.getText();

        if (user.isEmpty() || pass.isEmpty()) {
            lblLoginStatus.setText("Username and password required");
            return;
        }

        lblLoginStatus.setText("Connecting...");
        backend = new BackendClient(BACKEND_URL);

        // Network call on a background thread — never block the JavaFX thread.
        new Thread(() -> {
            try {
                boolean ok = backend.login(user, pass);

                Platform.runLater(() -> {
                    if (ok) {
                        lblLoginStatus.setText("Logged in as " + user);
                        lblUser.setText(user);
                        setStatus("Connected", true);
                        loadAllData();
                        startLiveFeed();
                        startPolling();
                    } else {
                        lblLoginStatus.setText("Invalid credentials");
                        setStatus("Not connected", false);
                    }
                });

            } catch (Exception e) {
                Platform.runLater(() -> {
                    lblLoginStatus.setText("Connection failed: " + e.getMessage());
                    setStatus("Not connected", false);
                });
            }
        }, "ids-login-thread").start();
    }
