		// TODO Auto-generated method stub
		
	}
	// In NetworkWhitelist.java — add this method
	public void refresh() {
	    // Clear and reload both sets
	    trustedIps.clear();
	    trustedMacs.clear();
	    approvedOrgIps.clear();
	    loadTrustedDevicesFromBackend();
	    loadApprovedOrgsFromBackend();
	    System.out.println("[Whitelist] Refreshed trusted devices from backend");
	}
    }