package com.ids.network;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Set;
import java.util.concurrent.ConcurrentHashMap;

/**
 * NetworkWhitelist — Engine version.
 * No Spring — loads work-hours config from properties file.
 * Loads trusted IPs/MACs from backend REST API at startup.
 */
public class NetworkWhitelist {

    // ── Backend connection config ──────────────────────────────────────
    private String backendUrl   = "http://localhost:8080";
    private String backendToken = "";

    // ── Time config — from ids-whitelist.properties ────────────────────
    private int     workStart    = 8;
    private int     workEnd      = 18;
    private String  timezone     = "Africa/Johannesburg";
    private boolean weekendAlert = true;

    // ── Trusted sets — populated from backend at startup ───────────────
    private final Set<String> trustedIps =
        Collections.newSetFromMap(new ConcurrentHashMap<>());
    private final Set<String> trustedMacs =
        Collections.newSetFromMap(new ConcurrentHashMap<>());

    // ── Approved orgs — populated from backend at startup ──────────────
    private final Set<String> approvedOrgIps =
        Collections.newSetFromMap(new ConcurrentHashMap<>());

    // ── Constructors ───────────────────────────────────────────────────
    public NetworkWhitelist() {
        loadProperties();
    }

    public NetworkWhitelist(String backendUrl, String backendToken) {
        this.backendUrl   = backendUrl;
        this.backendToken = backendToken;
        loadProperties();
        loadTrustedDevicesFromBackend();
        loadApprovedOrgsFromBackend();
    }
    // ── Properties loader ──────────────────────────────────────────────
    private void loadProperties() {
        try (java.io.InputStream in = getClass().getClassLoader()
                .getResourceAsStream("ids-whitelist.properties")) {
            if (in == null) {
                System.err.println("[Whitelist] ids-whitelist.properties not found" 
                    + " — using defaults");
                return;
            }
            java.util.Properties p = new java.util.Properties();
            p.load(in);
            workStart    = Integer.parseInt(
                p.getProperty("work.hours.start", "8"));
            workEnd      = Integer.parseInt(
                p.getProperty("work.hours.end",   "18"));
            timezone     = p.getProperty(
                "work.timezone", "Africa/Johannesburg");
            weekendAlert = Boolean.parseBoolean(
                p.getProperty("work.weekend.alert", "true"));
            System.out.println("[Whitelist] Properties loaded — work hours: "
                + workStart + ":00–" + workEnd + ":00 (" + timezone + ")");
        } catch (Exception e) {
            System.err.println("[Whitelist] Could not load properties: "
                + e.getMessage());
        }
    }

    // ── Load trusted IPs/MACs from my_whitelist table via REST ─────────
    private void loadTrustedDevicesFromBackend() {
        try {
            java.net.http.HttpClient client =
                java.net.http.HttpClient.newHttpClient();
            java.net.http.HttpRequest request =
                java.net.http.HttpRequest.newBuilder()
                    .uri(java.net.URI.create(backendUrl + "/api/my-whitelist"))
                    .header("Authorization", backendToken)
                    .timeout(java.time.Duration.ofSeconds(5))
                    .GET()
                    .build();

            java.net.http.HttpResponse<String> response = client.send(
                request, java.net.http.HttpResponse.BodyHandlers.ofString());

            if (response.statusCode() == 200) {
                com.fasterxml.jackson.databind.ObjectMapper mapper =
                    new com.fasterxml.jackson.databind.ObjectMapper();
                com.fasterxml.jackson.databind.JsonNode arr =
                    mapper.readTree(response.body());

                for (com.fasterxml.jackson.databind.JsonNode node : arr) {
                    String ip  = node.path("ip").asText(null);
                    String mac = node.path("mac").asText(null);
                    if (ip  != null && !ip.isBlank())  addTrustedIp(ip);
                    if (mac != null && !mac.isBlank()) addTrustedMac(mac);
                }
                System.out.printf("[Whitelist] Loaded %d trusted devices%n",
                    arr.size());
            } else {
                System.err.println("[Whitelist] Backend returned HTTP "
                    + response.statusCode());
            }
        } catch (Exception e) {
            System.err.println("[Whitelist] Could not load trusted devices: "
                + e.getMessage());
            System.err.println("[Whitelist] Running with system addresses only");
        }
    }

    // ── Load approved org IPs from org_whitelist table via REST ────────
    private void loadApprovedOrgsFromBackend() {
        try {
            java.net.http.HttpClient client =
                java.net.http.HttpClient.newHttpClient();
            java.net.http.HttpRequest request =
                java.net.http.HttpRequest.newBuilder()
                    .uri(java.net.URI.create(
                        backendUrl + "/api/org-whitelist"))
                    .header("Authorization", backendToken)
                    .timeout(java.time.Duration.ofSeconds(5))
                    .GET()
                    .build();

            java.net.http.HttpResponse<String> response = client.send(
                request, java.net.http.HttpResponse.BodyHandlers.ofString());

            if (response.statusCode() == 200) {
                com.fasterxml.jackson.databind.ObjectMapper mapper =
                    new com.fasterxml.jackson.databind.ObjectMapper();
                com.fasterxml.jackson.databind.JsonNode arr =
                    mapper.readTree(response.body());

                int count = 0;
                for (com.fasterxml.jackson.databind.JsonNode node : arr) {
                    boolean approved = node.path("approved").asBoolean(false);
                    String  ip       = node.path("ip").asText(null);
                    if (approved && ip != null && !ip.isBlank()) {
                        approvedOrgIps.add(normalize(ip));
                        count++;
                    }
                }
                System.out.printf("[Whitelist] Loaded %d approved org IPs%n",
                    count);
            }
        } catch (Exception e) {
            System.err.println("[Whitelist] Could not load org whitelist: "
                + e.getMessage());
        }
    }

    // ── Primary trust checks ───────────────────────────────────────────

    /** Full skip — returns true if packet should bypass ALL detectors */
    public boolean isTrusted(String ip) {
        if (ip == null) return true;
        String n = normalize(ip);
        return isSystemAddress(n) || trustedIps.contains(n);
    }

    private boolean isSystemAddress(String n) {
    	return n.startsWith("127.")          ||  // loopback
    	           n.equals("::1")              ||  // IPv6 loopback
    	           n.startsWith("224.")         ||  // multicast
    	           n.startsWith("239.")         ||  // multicast
    	           n.equals("255.255.255.255");  
	}

	private String normalize(String ip) {
		return ip.trim()
	             .replaceAll("^/", "")    // removes leading slash from InetAddress.toString()
	             .replaceAll(":.*$", ""); // removes port if present
	}

	/** Full skip — checks both IP and MAC */
    public boolean isTrusted(String ip, String mac) {
        if (isTrusted(ip)) return true;
        return mac != null && trustedMacs.contains(mac.toLowerCase());
    }

    /** Partial skip — suppress UNKNOWN_IP and OUTSIDE_SUBNET only */
    public boolean isApprovedOrg(String ip) {
        if (ip == null) return false;
        return approvedOrgIps.contains(normalize(ip));
    }

    // ── Runtime management ─────────────────────────────────────────────
    public void addTrustedIp(String ip) {
        if (ip != null && !ip.isBlank())
            trustedIps.add(normalize(ip));
    }

    public void addTrustedMac(String mac) {
        if (mac != null && !mac.isBlank())
            trustedMacs.add(mac.toLowerCase().trim());
    }

    // ── Getters for detector constructors ──────────────────────────────
    public String getGateway(){
    	return "192.168.8.1";
    	}
    public String getSubnet()          { return "192.168.8."; }
    public List<String> getInternalServers() { return new ArrayList<>(); }

    // ── Time config getters ────────────────────────────────────────────
    public int     getWorkStartHour() { return workStart; }
    public int     getWorkEndHour()   { return workEnd; }
    public String  getWorkTimezone()  { return timezone; }
    public boolean isWeekendAlert()   { return weekendAlert; }

    // ── Aliases — some detectors use these names ───────────────────────
    public int    getWorkStart() { return workStart; }
    public int    getWorkEnd()   { return workEnd; }

