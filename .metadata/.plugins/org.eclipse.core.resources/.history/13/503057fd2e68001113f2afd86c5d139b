package com.ids.detectors;

import com.ids.alerts.AlertManager;
import com.ids.models.PacketContext;
import com.ids.models.ThreatEvent;
import com.ids.models.ThreatEvent.Severity;
import com.ids.models.ThreatEvent.ThreatType;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

/**
 * Detects TCP SYN flood / volumetric DDoS against a single destination
 * service.
 *
 * Unlike NmapScanDetector (one source -> many destination ports = recon),
 * this watches the inverse: many SYN packets -> one destination IP:port,
 * regardless of how many distinct sources they come from. That's the
 * textbook DoS/DDoS pattern — a target's TCP backlog queue fills with
 * half-open connections faster than it can process them.
 *
 * Tracking key is the DESTINATION (dstIP:dstPort), not the source.
 *
 * LIMITATION (intentional, for now): this is rate-based only — SYN count
 * per 2s window. It does NOT track SYN/ACK completion ratios, which is
 * what real connection-state tracking (SYN cookies, stateful firewalls)
 * does to distinguish "flash crowd of legitimate users" from "flood".
 * If you deploy this in front of an internet-facing service with real
 * traffic spikes, raise SYN_THRESHOLD accordingly — see notes below.
 */
public class SynFloodDetector implements Detector {

    private static final long WINDOW_MS   = 2_000L;
    private static final long COOLDOWN_MS = 10_000L;

    // SYNs to one dst:port in WINDOW_MS before this is a flood.
    // 100/2s = 50/sec. On a LAN-monitoring deployment (internal servers,
    // no public traffic) this is already far above normal connection
    // churn. In front of a real internet-facing service, raise this —
    // a busy site can legitimately see hundreds of SYN/sec.
    private static final int SYN_THRESHOLD = 100;

    // synCount >= SYN_THRESHOLD * this -> CRITICAL even from few sources
    private static final int CRITICAL_MULTIPLIER = 2;

    // This many distinct source IPs hitting the same dst:port within the
    // window reclassifies the event as distributed (DDoS) regardless of
    // per-source rate — a botnet spreading load thin per-bot still adds
    // up at the victim.
    private static final int DISTRIBUTED_SOURCE_THRESHOLD = 10;

    /** Per-destination SYN tracking. Key: "dstIP:dstPort" */
    private static final class DestRecord {
        private final List<Long> synTimestamps = new ArrayList<>();
        private final Map<String, Long> sources = new HashMap<>(); // srcIP -> lastSeen

        synchronized void record(String srcIP, long now) {
            synTimestamps.add(now);
            synTimestamps.removeIf(t -> (now - t) > WINDOW_MS);
            sources.put(srcIP, now);
            sources.entrySet().removeIf(e -> (now - e.getValue()) > WINDOW_MS);
        }

        synchronized int getSynCount(long now) {
            synTimestamps.removeIf(t -> (now - t) > WINDOW_MS);
            return synTimestamps.size();
        }

        synchronized int getUniqueSourceCount(long now) {
            sources.entrySet().removeIf(e -> (now - e.getValue()) > WINDOW_MS);
            return sources.size();
        }

        synchronized boolean isStale(long now) {
            return synTimestamps.isEmpty()
                    || (now - synTimestamps.get(synTimestamps.size() - 1)) > WINDOW_MS * 10;
        }
    }

    private final Map<String, DestRecord> destinations = new ConcurrentHashMap<>();
    private final Map<String, Long> lastAlerts = new ConcurrentHashMap<>();

    private final AlertManager alertManager;
	private int dstPort;

    public SynFloodDetector(AlertManager alertManager) {
        this.alertManager = alertManager;
    }

    public void analyze(PacketContext ctx) {

        if (!ctx.isTcp()) return;
        if (!ctx.isSyn() || ctx.isAck()) return; // pure SYN only, not SYN-ACK replies

        String srcIP   = ctx.getSrcIp();
        String dstIP   = ctx.getDstIp();
        String srcMac  = ctx.getSrcMac();
        String dstMac  = ctx.getDstMac();
        int    dstPort = ctx.getDstPort();
        long   now     = ctx.getTimestamp();

        if (srcIP == null || dstIP == null) return;

        String destKey = dstIP + ":" + dstPort;
        DestRecord rec = destinations.computeIfAbsent(destKey, k -> new DestRecord());
        rec.record(srcIP, now);

        int synCount = rec.getSynCount(now);
        if (synCount < SYN_THRESHOLD) return;

        int uniqueSources = rec.getUniqueSourceCount(now);

        Severity severity;
        String details;

        if (uniqueSources >= DISTRIBUTED_SOURCE_THRESHOLD) {
            severity = Severity.CRITICAL;
            details = "Distributed SYN flood (DDoS): " + synCount + " SYN/"
                    + (WINDOW_MS / 1000) + "s from " + uniqueSources
                    + " unique sources targeting " + dstIP + ":" + dstPort;
        } else if (synCount >= SYN_THRESHOLD * CRITICAL_MULTIPLIER) {
            severity = Severity.CRITICAL;
            details = "SYN flood: " + synCount + " SYN/" + (WINDOW_MS / 1000)
                    + "s from " + uniqueSources + " source(s) targeting "
                    + dstIP + ":" + dstPort;
        } else {
            severity = Severity.HIGH;
            details = "SYN flood: " + synCount + " SYN/" + (WINDOW_MS / 1000)
                    + "s from " + uniqueSources + " source(s) targeting "
                    + dstIP + ":" + dstPort;
        }

        raise(destKey, ThreatType.SYN_FLOOD,
                srcIP, srcMac, dstIP, dstMac, synCount, now,
                details, severity, dstPort);
    }

    private void raise(String key, ThreatType type,
                        String srcIP, String srcMac, String dstIP, String dstMac,
                        int count, long now, String details, Severity sev, int port) {
        Long last = lastAlerts.get(key);
        if (last != null && (now - last) < COOLDOWN_MS) return;
        lastAlerts.put(key, now);
        alertManager.raise(new ThreatEvent(
                type, srcIP, srcMac, dstIP, dstMac,
                count, WINDOW_MS, details, sev, "TCP", "DDOS", dstPort
        ));
    }

    @Override
    public void cleanup() {
        long now = System.currentTimeMillis();
        destinations.entrySet().removeIf(e -> e.getValue().isStale(now));
        lastAlerts.entrySet().removeIf(e -> (now - e.getValue()) > COOLDOWN_MS * 4);
    }
}