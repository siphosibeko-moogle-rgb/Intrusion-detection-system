package com.ids.desktop.viewmodel;

import com.ids.desktop.model.AlertItem;
import com.ids.desktop.model.CaseItem;
import com.ids.desktop.model.FlaggedIpItem;
import com.ids.desktop.model.MyWhitelistItem;
import com.ids.desktop.model.OrgWhitelistItem;
import com.ids.desktop.service.BackendClient;

import javafx.application.Platform;
import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.collections.transformation.FilteredList;

import java.util.List;
import java.util.Map;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;
import java.util.function.Consumer;
import java.util.stream.Collectors;

/**
 * Holds all mutable state for the dashboard UI.
 *
 * WHY a ViewModel:
 *   JavaFX controllers are tightly coupled to FXML — they exist to wire
 *   UI components to data. When you put business logic AND state in the
 *   controller, testing becomes impossible (you can't instantiate a controller
 *   without an FXML scene) and the file grows without bound.
 *
 *   The ViewModel owns the data. The controller owns the display.
 *   The controller calls ViewModel methods; it never touches BackendClient directly.
 */
public class DashboardViewModel {

    // ── Observable state ────────────────────────────────────────────────────
    // These are the ONLY lists the controller should bind to.
    // All mutations go through this class, not through the controller.

    private final ObservableList<AlertItem>        allAlerts       = FXCollections.observableArrayList();
    private final ObservableList<AlertItem>        attackers        = FXCollections.observableArrayList();
    private final ObservableList<String>           liveFeed         = FXCollections.observableArrayList();
    private final ObservableList<CaseItem>         cases            = FXCollections.observableArrayList();
    private final ObservableList<MyWhitelistItem>  myWhitelist      = FXCollections.observableArrayList();
    private final ObservableList<OrgWhitelistItem> orgAccepted      = FXCollections.observableArrayList();
    private final ObservableList<OrgWhitelistItem> orgPending       = FXCollections.observableArrayList();
    private final ObservableList<FlaggedIpItem>    flaggedIps       = FXCollections.observableArrayList();

    // ── Derived / filtered views ─────────────────────────────────────────────
    // FilteredList wraps the raw list. The controller sets the predicate;
    // the ViewModel exposes the filtered view to bind to the table.
    private final FilteredList<AlertItem>        filteredAlerts   = new FilteredList<>(allAlerts,   p -> true);
    private final FilteredList<MyWhitelistItem>  filteredMyWl     = new FilteredList<>(myWhitelist, p -> true);
    private final FilteredList<OrgWhitelistItem> filteredAccepted = new FilteredList<>(orgAccepted, p -> true);
    private final FilteredList<OrgWhitelistItem> filteredPending  = new FilteredList<>(orgPending,  p -> true);
    private final FilteredList<CaseItem>         filteredCases    = new FilteredList<>(cases,        p -> true);

    // ── Config ───────────────────────────────────────────────────────────────
    private static final int MAX_LIVE_ENTRIES = 500;
    private static final int MAX_ALERTS_IN_MEMORY = 2000;

    // ── Threading ────────────────────────────────────────────────────────────
    // One shared pool for all background work.
    // WHY a fixed pool of 3:
    //   - Thread 1: alert polling
    //   - Thread 2: whitelist/case loading
    //   - Thread 3: user-initiated actions (add whitelist, create case, etc.)
    // Raw 'new Thread()' creates unlimited OS threads — a pool caps the cost.
    private final ExecutorService executor =
            Executors.newFixedThreadPool(3, r -> {
                Thread t = new Thread(r, "ids-worker");
                t.setDaemon(true);
                return t;
            });

    private final ScheduledExecutorService scheduler =
            Executors.newSingleThreadScheduledExecutor(r -> {
                Thread t = new Thread(r, "ids-poll");
                t.setDaemon(true);
                return t;
            });

    // ── Dependencies ─────────────────────────────────────────────────────────
    private final BackendClient backend;

    // ── Callbacks to notify the controller ───────────────────────────────────
    // Instead of the ViewModel touching UI labels directly,
    // it calls these callbacks. The controller registers them in initialize().
    private Consumer<String> onStatusChange  = msg -> {};
    private Consumer<Boolean> onConnected    = ok -> {};
    private Runnable onStatsUpdate           = () -> {};

    // ── Attacker rebuild throttle ─────────────────────────────────────────────
    private long lastAttackerRebuild = 0L;

    public DashboardViewModel(BackendClient backend) {
        this.backend = backend;
    }

    // ── Accessors for the controller to bind tables ───────────────────────────

    public FilteredList<AlertItem>        getFilteredAlerts()   { return filteredAlerts; }
    public FilteredList<MyWhitelistItem>  getFilteredMyWl()     { return filteredMyWl; }
    public FilteredList<OrgWhitelistItem> getFilteredAccepted() { return filteredAccepted; }
    public FilteredList<OrgWhitelistItem> getFilteredPending()  { return filteredPending; }
    public FilteredList<CaseItem>         getFilteredCases()    { return filteredCases; }
    public ObservableList<AlertItem>      getAttackers()        { return attackers; }
    public ObservableList<String>         getLiveFeed()         { return liveFeed; }
    public ObservableList<FlaggedIpItem>  getFlaggedIps()       { return flaggedIps; }

    // Stats — controller reads these directly after onStatsUpdate fires
    public int getTotalAlerts()    { return allAlerts.size(); }
    public long getCriticalCount() { return allAlerts.stream().filter(a -> "CRITICAL".equals(a.getSeverity())).count(); }
    public long getHighCount()     { return allAlerts.stream().filter(a -> "HIGH".equals(a.getSeverity())).count(); }
    public long getMediumCount()   { return allAlerts.stream().filter(a -> "MEDIUM".equals(a.getSeverity())).count(); }
    public int getPendingOrgCount(){ return orgPending.size(); }
    public int getFlaggedCount()   { return flaggedIps.size(); }

    // ── Callback registration ─────────────────────────────────────────────────

    public void setOnStatusChange(Consumer<String> cb)  { this.onStatusChange = cb; }
    public void setOnConnected(Consumer<Boolean> cb)     { this.onConnected = cb; }
    public void setOnStatsUpdate(Runnable cb)            { this.onStatsUpdate = cb; }

    // ── Filter setters (controller calls these when text fields change) ────────

    public void setAlertFilter(String ip, String mac, String type,
                               String severity, String protocol) {
        filteredAlerts.setPredicate(a -> {
            if (!ip.isEmpty()       && !a.getSourceIp().toLowerCase().contains(ip))       return false;
            if (!mac.isEmpty()      && (a.getSourceMac() == null
                                        || !a.getSourceMac().toLowerCase().contains(mac))) return false;
            if (!type.isEmpty()     && !a.getThreatType().toLowerCase().contains(type))    return false;
            if (!severity.isEmpty() && !severity.equals(a.getSeverity()))                  return false;
            if (!protocol.isEmpty() && !protocol.equals(a.getProtocol()))                  return false;
            return true;
        });
    }

    public void setWhitelistFilter(String text) {
        String f = text.toLowerCase();
        filteredMyWl.setPredicate(w ->
                f.isEmpty()
                || w.getIp().toLowerCase().contains(f)
                || (w.getMac()   != null && w.getMac().toLowerCase().contains(f))
                || (w.getLabel() != null && w.getLabel().toLowerCase().contains(f)));
        filteredAccepted.setPredicate(o ->
                f.isEmpty()
                || o.getIp().toLowerCase().contains(f)
                || (o.getOrgName() != null && o.getOrgName().toLowerCase().contains(f)));
        filteredPending.setPredicate(o ->
                f.isEmpty()
                || o.getIp().toLowerCase().contains(f)
                || (o.getOrgName() != null && o.getOrgName().toLowerCase().contains(f)));
    }

    public void setCaseFilter(String status, String ip) {
        filteredCases.setPredicate(c -> {
            if (!status.isEmpty() && !c.getStatus().toLowerCase().contains(status)) return false;
            if (!ip.isEmpty()     && !c.getSuspectIp().toLowerCase().contains(ip))  return false;
            return true;
        });
    }

    // ── Data loading ──────────────────────────────────────────────────────────

    public void loadAll() {
        loadAlerts();
        loadWhitelist();
        loadCases();
    }

    public void loadAlerts() {
        executor.submit(() -> {
            try {
                List<AlertItem> items = backend.fetchAlerts();
                // Cap memory — keep newest 2000
                List<AlertItem> capped = items.size() > MAX_ALERTS_IN_MEMORY
                        ? items.subList(0, MAX_ALERTS_IN_MEMORY) : items;
                Platform.runLater(() -> {
                    allAlerts.setAll(capped);
                    rebuildAttackers();
                    onStatsUpdate.run();
                });
            } catch (Exception e) {
                Platform.runLater(() -> onStatusChange.accept("Alert load failed: " + e.getMessage()));
            }
        });
    }

    public void loadWhitelist() {
        executor.submit(() -> {
            try {
                List<MyWhitelistItem>  myItems  = backend.fetchMyWhitelist();
                List<OrgWhitelistItem> orgItems = backend.fetchOrgWhitelist();
                List<FlaggedIpItem>    flagged  = backend.fetchFlaggedIps();

                List<OrgWhitelistItem> accepted = orgItems.stream()
                        .filter(OrgWhitelistItem::getApproved).collect(Collectors.toList());
                List<OrgWhitelistItem> pending  = orgItems.stream()
                        .filter(o -> !o.getApproved()).collect(Collectors.toList());

                Platform.runLater(() -> {
                    myWhitelist .setAll(myItems);
                    orgAccepted .setAll(accepted);
                    orgPending  .setAll(pending);
                    flaggedIps  .setAll(flagged);
                    onStatsUpdate.run();
                });
            } catch (Exception e) {
                System.err.println("[ViewModel] Whitelist load error: " + e.getMessage());
            }
        });
    }

    public void loadCases() {
        executor.submit(() -> {
            try {
                List<CaseItem> items = backend.fetchCases();
                Platform.runLater(() -> cases.setAll(items));
            } catch (Exception e) {
                System.err.println("[ViewModel] Cases load error: " + e.getMessage());
            }
        });
    }

    // ── Live feed injection (called by LiveFeedClient callback) ───────────────

    /**
     * Called from the WebSocket I/O thread — MUST be on Platform.runLater.
     * The controller passes this as a Consumer<JsonNode> to LiveFeedClient.
     */
    public void injectLiveAlert(AlertItem item, String feedLine) {
        // Must be called on FX thread already (Platform.runLater in MainController)
        liveFeed.add(0, feedLine);
        if (liveFeed.size() > MAX_LIVE_ENTRIES) {
            liveFeed.remove(liveFeed.size() - 1);
        }
        allAlerts.add(0, item);

        long now = System.currentTimeMillis();
        if (now - lastAttackerRebuild > 5_000) {
            lastAttackerRebuild = now;
            rebuildAttackers();
        }
        onStatsUpdate.run();
    }

    // ── Attacker aggregation ──────────────────────────────────────────────────

    /**
     * WHY O(n) instead of O(n²):
     *   Old code: for each top-IP, scan allAlerts again to find the MAC → O(n * top_k)
     *   New code: build IP→MAC map in the SAME pass as the count map → O(n) total
     */
    private void rebuildAttackers() {
        // Single pass: count hits AND capture first-seen MAC per IP
        Map<String, long[]> ipData = new java.util.LinkedHashMap<>();
        Map<String, String> ipMac  = new java.util.HashMap<>();

        for (AlertItem a : allAlerts) {
            String ip = a.getSourceIp();
            if (ip == null || ip.isEmpty()) continue;
            ipData.computeIfAbsent(ip, k -> new long[]{0})[0]++;
            ipMac.putIfAbsent(ip, a.getSourceMac() != null ? a.getSourceMac() : "");
        }

        List<AlertItem> top = ipData.entrySet().stream()
                .sorted(Map.Entry.<String, long[]>comparingByValue(
                        (a, b) -> Long.compare(b[0], a[0])))
                .limit(20)
                .map(e -> new AlertItem(
                        "", "",
                        "",
                        e.getKey(),
                        ipMac.get(e.getKey()),
                        "", "", "",
                        (int) e.getValue()[0],
                        ""))
                .collect(Collectors.toList());

        attackers.setAll(top);
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    public void addMyWhitelist(String ip, String mac, String label, Runnable onSuccess, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                backend.addMyWhitelistEntry(ip, mac, label);
                Platform.runLater(() -> { loadWhitelist(); onSuccess.run(); });
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void deleteMyWhitelist(long id, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                backend.deleteMyWhitelistEntry(id);
                Platform.runLater(this::loadWhitelist);
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void approveOrgs(List<OrgWhitelistItem> items, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                for (OrgWhitelistItem item : items) backend.approveOrg(item.getId());
                Platform.runLater(this::loadWhitelist);
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void approveAllOrgs(Consumer<String> onError) {
        executor.submit(() -> {
            try {
                backend.approveAllOrgs();
                Platform.runLater(this::loadWhitelist);
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void deleteOrgEntry(long id, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                backend.deleteOrgEntry(id);
                Platform.runLater(this::loadWhitelist);
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void acceptFlaggedIps(List<FlaggedIpItem> items, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                for (FlaggedIpItem item : items)
                    backend.addMyWhitelistEntry(item.getIp(), item.getMac(),
                            "Accepted from " + item.getThreatType());
                Platform.runLater(this::loadWhitelist);
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void createCase(String title, String suspectIp, String suspectMac,
                           String severity, Runnable onSuccess, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                backend.createCase(title, "", suspectIp, suspectMac, severity, "");
                Platform.runLater(() -> { loadCases(); onSuccess.run(); });
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    public void closeCase(long id, String findings, Runnable onSuccess, Consumer<String> onError) {
        executor.submit(() -> {
            try {
                backend.updateCaseStatus(id, "CLOSED", findings);
                Platform.runLater(() -> { loadCases(); onSuccess.run(); });
            } catch (Exception e) {
                Platform.runLater(() -> onError.accept(e.getMessage()));
            }
        });
    }

    // ── Polling ───────────────────────────────────────────────────────────────

    public void startPolling() {
        scheduler.scheduleAtFixedRate(this::loadAlerts, 30, 30, TimeUnit.SECONDS);
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    public void shutdown() {
        scheduler.shutdownNow();
        executor.shutdownNow();
        try { scheduler.awaitTermination(2, TimeUnit.SECONDS); }
        catch (InterruptedException ignored) {}
    }
}