<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark SOC palette: this app gets opened in dim rooms and at 3am. -->
    <color name="bg">#0F1419</color>
    <color name="surface">#1A2129</color>
    <color name="surface_alt">#232C36</color>
    <color name="text_primary">#E6EDF3</color>
    <color name="text_secondary">#8B99A6</color>
    <color name="accent">#3B82F6</color>

    <!-- Health status -->
    <color name="status_ok">#22C55E</color>
    <color name="status_warn">#F59E0B</color>
    <color name="status_error">#EF4444</color>
    <color name="status_unknown">#6B7280</color>

    <!-- Severity. Deliberately NOT the same greens/reds as health status:
         a CRITICAL alert and a failing disk are different kinds of bad and
         should not be confusable at a glance. -->
    <color name="sev_critical">#DC2626</color>
    <color name="sev_high">#EA580C</color>
    <color name="sev_medium">#CA8A04</color>
    <color name="sev_low">#2563EB</color>
</resources>
