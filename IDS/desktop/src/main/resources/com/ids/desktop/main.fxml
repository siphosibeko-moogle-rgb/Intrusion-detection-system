<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ids.desktop.controller.MainController">

    <!-- HEADER -->
    <top>
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:10 16; -fx-background-color:#ffffff; -fx-border-color:#e5e7eb; -fx-border-width:0 0 1 0;">
        <Label text="IDS" style="-fx-font-size:16; -fx-font-weight:bold; -fx-text-fill:#111827;"/>
        <Label fx:id="lblStatus" style="-fx-text-fill:#6b7280;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <StackPane fx:id="healthHost"/>
        <Label fx:id="lblUser" text="User" style="-fx-text-fill:#374151;"/>
    </HBox>
</top>

    <!-- CENTER -->
    <center>
        <VBox spacing="15" style="-fx-padding:15;">
            <!-- TABS -->
            <TabPane VBox.vgrow="ALWAYS">
            <Tab text="Dashboard">
    <StackPane fx:id="dashboardHost"/>
</Tab>

                <!-- ALERTS TAB -->
                <Tab text="Alerts">
                    <VBox spacing="10" style="-fx-padding:10;">
                        <HBox spacing="10">
                            <TextField fx:id="tfFilterIp"       promptText="IP"/>
                            <TextField fx:id="tfFilterMac"      promptText="MAC"/>
                            <TextField fx:id="tfFilterType"     promptText="Type"/>
                            <ComboBox  fx:id="cbFilterSeverity" promptText="Severity"/>
                            <ComboBox  fx:id="cbFilterProtocol" promptText="Protocol"/>
                            <Button text="Clear"   onAction="#onClearFilters"/>
                            <Button text="Refresh" onAction="#onRefresh"/>
                        </HBox>
                        <TableView fx:id="alertTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTimestamp"   text="Time"/>
                                <TableColumn fx:id="colSeverity"    text="Severity"/>
                                <TableColumn fx:id="colThreatType"  text="Threat"/>
                                <TableColumn fx:id="colSourceIp"    text="Source IP"/>
                                <TableColumn fx:id="colSourceMac"   text="MAC"/>
                                <TableColumn fx:id="colDestIp"      text="Dest IP"/>
                                <TableColumn fx:id="colProtocol"    text="Protocol"/>
                                <TableColumn fx:id="colRequestType" text="Request"/>
                                <TableColumn fx:id="colPackets"     text="Packets"/>
                                <TableColumn fx:id="colDetails"     text="Details"/>
                                <TableColumn fx:id="colOccurrences" text="Occurrences"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- WHITELIST TAB -->
                <Tab text="Whitelist">
                    <TabPane tabClosingPolicy="UNAVAILABLE">

                        <!-- SUB-TAB 1: TRUSTED DEVICES -->
                        <Tab text="Trusted Devices">
                            <VBox spacing="6" style="-fx-padding:10;">
                                <HBox spacing="10">
                                    <TextField fx:id="tfFilterWlIp"
                                               promptText="Filter IP / MAC / Label"/>
                                </HBox>
                                <Label text="My Whitelist — Trusted Devices"
                                       style="-fx-font-weight:bold;"/>
                                <TableView fx:id="myWhitelistTable"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMyWlIp"
                                                     text="IP"/>
                                        <TableColumn fx:id="colMyWlMac"
                                                     text="MAC"/>
                                        <TableColumn fx:id="colMyWlLabel"
                                                     text="Label"/>
                                        <TableColumn fx:id="colMyWlAddedAt"
                                                     text="Added At"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="8">
                                    <TextField fx:id="tfNewMyWlIp"
                                               promptText="IP"/>
                                    <TextField fx:id="tfNewMyWlMac"
                                               promptText="MAC"/>
                                    <TextField fx:id="tfNewMyWlLabel"
                                               promptText="Label (e.g. Router)"/>
                                    <Button text="Add"
                                            onAction="#onAddMyWhitelist"/>
                                    <Button text="Delete Selected"
                                            onAction="#onDeleteMyWhitelist"/>
                                </HBox>
                            </VBox>
                        </Tab>

                        <!-- SUB-TAB 2: TRUSTED NETWORKS (provider CIDR ranges) -->
                        <Tab text="Trusted Networks">
                            <VBox spacing="6" style="-fx-padding:10;">
                                <Label text="Trusted Networks — Provider CIDR Ranges (Cloudflare / AWS / Google / Azure)"
                                       style="-fx-font-weight:bold;"/>
                                <TableView fx:id="trustedNetworkTable"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTnCidr"
                                                     text="CIDR"/>
                                        <TableColumn fx:id="colTnProvider"
                                                     text="Provider"/>
                                        <TableColumn fx:id="colTnCategory"
                                                     text="Category"/>
                                        <TableColumn fx:id="colTnEnabled"
                                                     text="Enabled"/>
                                        <TableColumn fx:id="colTnSuppress"
                                                     text="Suppress Beaconing"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <TextField fx:id="tfNewTnCidr"
                                               promptText="CIDR (e.g. 104.16.0.0/13)"/>
                                    <TextField fx:id="tfNewTnProvider"
                                               promptText="Provider (e.g. Cloudflare)"/>
                                    <TextField fx:id="tfNewTnCategory"
                                               promptText="Category (e.g. CDN)"/>
                                    <CheckBox fx:id="cbNewTnSuppressBeaconing"
                                              text="Suppress beaconing"/>
                                    <Button text="Add"
                                            onAction="#onAddTrustedNetwork"/>
                                    <Button text="Enable/Disable"
                                            onAction="#onToggleTrustedNetwork"/>
                                    <Button text="Sync Provider Feeds"
                                            onAction="#onSyncTrustedNetworks"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#3b82f6;"/>
                                    <Button text="Delete Selected"
                                            onAction="#onDeleteTrustedNetwork"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#ef4444;"/>
                                </HBox>
                            </VBox>
                        </Tab>

                        <!-- SUB-TAB 3: TRIAGE (Flagged IPs) -->
                        <Tab fx:id="tabTriage" text="Triage (0)">
                            <VBox spacing="6" style="-fx-padding:10;">
                                <HBox spacing="10">
                                    <Label fx:id="lblFlaggedCount"
                                           text="Flagged IPs — 0 pending"
                                           style="-fx-font-weight:bold;
                                                  -fx-text-fill:#f59e0b;"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <CheckBox fx:id="cbSelectAllFlagged"
                                              text="Select All"
                                              onAction="#onSelectAllFlagged"/>
                                </HBox>
                                <TableView fx:id="flaggedIpTable"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colFlagSel"
                                                     text="✓"/>
                                        <TableColumn fx:id="colFlagIp"
                                                     text="IP"/>
                                        <TableColumn fx:id="colFlagMac"
                                                     text="MAC"/>
                                        <TableColumn fx:id="colFlagOrg"
                                                     text="Organization"/>
                                        <TableColumn fx:id="colFlagThreat"
                                                     text="Threats"/>
                                        <TableColumn fx:id="colFlagSeverity"
                                                     text="Severity"/>
                                        <TableColumn fx:id="colFlagProto"
                                                     text="Protocols"/>
                                        <TableColumn fx:id="colFlagHits"
                                                     text="Hits"/>
                                        <TableColumn fx:id="colFlagSeen"
                                                     text="Last Seen"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="8">
                                    <Button text="Accept Selected"
                                            onAction="#onAcceptFlagged"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#22c55e;"/>
                                    <Button text="Remove Selected"
                                            onAction="#onRemoveFlagged"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#ef4444;"/>
                                </HBox>
                            </VBox>
                        </Tab>

                        <!-- SUB-TAB 4: CONFIG -->
                        <Tab text="Config">
                            <VBox spacing="12" style="-fx-padding:12;">

                                <!-- SECTION 1: Trust data (LIVE — no restart). Read-only
                                     pointer; the actual CRUD stays in the tabs above so we
                                     don't ship a confusing duplicate editor. -->
                                <VBox spacing="4"
                                      style="-fx-padding:10; -fx-background-color:#f0fdf4;
                                             -fx-border-color:#bbf7d0; -fx-border-radius:6;
                                             -fx-background-radius:6;">
                                    <Label text="Trust data — LIVE (no restart needed)"
                                           style="-fx-font-weight:bold; -fx-text-fill:#15803d;"/>
                                    <Label wrapText="true" style="-fx-text-fill:#374151;"
                                           text="Trusted devices and provider CIDR ranges are stored in the database and sync to the engine automatically (about every 30s). Edit them in the &quot;Trusted Devices&quot; and &quot;Trusted Networks&quot; sub-tabs above — they are intentionally not duplicated here."/>
                                </VBox>

                                <!-- SECTION 2: Engine host-local config (RESTART REQUIRED).
                                     The real new functionality: view/edit the engine's own
                                     ids.capture.interfaces via its 127.0.0.1:9091 endpoint. -->
                                <VBox spacing="8" VBox.vgrow="ALWAYS"
                                      style="-fx-padding:10; -fx-background-color:#fffbeb;
                                             -fx-border-color:#fde68a; -fx-border-radius:6;
                                             -fx-background-radius:6;">
                                    <Label text="Engine capture interfaces — HOST-LOCAL (RESTART REQUIRED)"
                                           style="-fx-font-weight:bold; -fx-text-fill:#b45309;"/>
                                    <Label wrapText="true" style="-fx-text-fill:#374151;"
                                           text="These live in the engine's ids-whitelist.properties on the engine host and are read once at startup. Changes take effect only after the engine is restarted."/>
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Label text="Currently configured:"
                                               style="-fx-text-fill:#374151;"/>
                                        <Label fx:id="lblEngineCurrentIfaces" text="(loading…)"
                                               style="-fx-font-weight:bold; -fx-text-fill:#0e7490;"/>
                                    </HBox>
                                    <Label text="Interfaces present on the engine host — check the ones to capture on:"
                                           style="-fx-text-fill:#374151;"/>
                                    <ListView fx:id="lvEngineInterfaces"
                                              VBox.vgrow="ALWAYS" prefHeight="200"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Button text="Save"
                                                onAction="#onSaveEngineConfig"
                                                style="-fx-text-fill:white;
                                                       -fx-background-color:#3b82f6;"/>
                                        <Button text="Reload"
                                                onAction="#onReloadEngineConfig"/>
                                    </HBox>

                                    <!-- SECTION 2b: structured settings form (RESTART
                                         REQUIRED, same as the interface list above).
                                         Own Save button — one writer per key, so this
                                         never touches ids.capture.interfaces. Reload
                                         above refreshes this form too (one GET returns
                                         both). -->
                                    <Separator/>
                                    <Label text="Engine network settings — HOST-LOCAL (RESTART REQUIRED)"
                                           style="-fx-font-weight:bold; -fx-text-fill:#b45309;"/>
                                    <Label wrapText="true" style="-fx-text-fill:#374151;"
                                           text="Also read once at startup from the engine's ids-whitelist.properties. Changes take effect only after the engine is restarted."/>

                                    <GridPane hgap="8" vgap="6">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="170"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <Label text="Local subnet" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <TextField fx:id="tfEngineSubnet"
                                                   promptText="192.168.8.0/24 or 192.168.8."
                                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Gateway" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                        <TextField fx:id="tfEngineGateway"
                                                   promptText="192.168.8.1"
                                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Docker subnets" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                        <TextField fx:id="tfEngineDockerSubnets"
                                                   promptText="10.50.0.0/16, 172.17.0."
                                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                        <Label text="Trusted scanner IPs" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                        <TextField fx:id="tfEngineTrustedScanners"
                                                   promptText="10.0.0.50, 10.0.0.51"
                                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                        <Label text="Trusted beacon destinations" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                        <TextField fx:id="tfEngineBeaconDestinations"
                                                   promptText="10.0.0.5, 203.0.113.9"
                                                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                        <Label text="Trusted DHCP server MACs" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                        <TextField fx:id="tfEngineDhcpMacs"
                                                   promptText="aa:bb:cc:dd:ee:ff"
                                                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                        <Label text="Capture mode" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                                        <ComboBox fx:id="cbEngineCaptureMode"
                                                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                                    </GridPane>

                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Button text="Save settings"
                                                onAction="#onSaveEngineSettings"
                                                style="-fx-text-fill:white;
                                                       -fx-background-color:#3b82f6;"/>
                                    </HBox>

                                    <Label fx:id="lblEngineConfigBanner"
                                           wrapText="true" visible="false" managed="false"/>
                                </VBox>

                            </VBox>
                        </Tab>

                    </TabPane>
                </Tab>
                <!-- END Whitelist Tab -->

                <!-- CASES -->
<Tab text="Cases">
    <VBox spacing="10" style="-fx-padding:10;">

        <!-- Filters -->
        <HBox spacing="10">

            <TextField fx:id="tfCaseFilterStatus"
                       promptText="Status"/>

            <TextField fx:id="tfCaseFilterIp"
                       promptText="IP"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="🛡 Create Cases from Alerts"
                    onAction="#onOpenAlertGroups"
                    style="-fx-background-color:#1f6feb;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

        </HBox>

        <!-- Cases Table -->
        <TableView fx:id="casesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCaseNum"
                             text="Case #"/>
                <TableColumn fx:id="colCaseTitle"
                             text="Title"/>
                <TableColumn fx:id="colCaseStatus"
                             text="Status"/>
                <TableColumn fx:id="colCaseSeverity"
                             text="Severity"/>
                <TableColumn fx:id="colCaseSuspectIp"
                             text="IP"/>
                <TableColumn fx:id="colCaseSuspectMac"
                             text="MAC"/>
                <TableColumn fx:id="colCaseThreatType"
                             text="Threat"/>
                <TableColumn fx:id="colCaseAssignedTo"
                             text="Assigned"/>
                <TableColumn fx:id="colCaseOpenedAt"
                             text="Opened"/>
            </columns>
        </TableView>

        <!-- Manual Case Creation -->
        <HBox spacing="10">
            <TextField fx:id="tfNewCaseTitle"
                       promptText="Title"/>
            <TextField fx:id="tfNewCaseSuspectIp"
                       promptText="IP"/>
            <TextField fx:id="tfNewCaseSuspectMac"
                       promptText="MAC"/>
            <ComboBox fx:id="cbNewCaseSeverity"/>
            <Button text="Create Case"
                    onAction="#onCreateCase"/>
            <Button text="Close Case"
                    onAction="#onCloseCase"/>
        </HBox>

        <Label fx:id="lblCaseStatus"/>

    </VBox>
</Tab>

            </TabPane>

        </VBox>
    </center>

</BorderPane>