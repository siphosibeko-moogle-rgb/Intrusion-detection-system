<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ids.desktop.controller.MainController">

    <!-- HEADER -->
    <top>
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:10 16; -fx-background-color:#ffffff; -fx-border-color:#e5e7eb; -fx-border-width:0 0 1 0;">
        <Label text="IDS" style="-fx-font-size:16; -fx-font-weight:bold; -fx-text-fill:#111827;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <StackPane fx:id="healthHost"/>
        <Label fx:id="lblUser" text="User" style="-fx-text-fill:#374151;"/>
    </HBox>
</top>

    <!-- CENTER -->
    <center>
        <VBox spacing="15" style="-fx-padding:15;">
            <!-- TABS -->
            <TabPane VBox.vgrow="ALWAYS">
            <Tab text="Dashboard">
    <StackPane fx:id="dashboardHost"/>
</Tab>

                <!-- ALERTS TAB -->
                <Tab text="Alerts">
                    <VBox spacing="10" style="-fx-padding:10;">
                        <HBox spacing="10">
                            <TextField fx:id="tfFilterIp"       promptText="IP"/>
                            <TextField fx:id="tfFilterMac"      promptText="MAC"/>
                            <TextField fx:id="tfFilterType"     promptText="Type"/>
                            <ComboBox  fx:id="cbFilterSeverity" promptText="Severity"/>
                            <ComboBox  fx:id="cbFilterProtocol" promptText="Protocol"/>
                            <Button text="Clear"   onAction="#onClearFilters"/>
                            <Button text="Refresh" onAction="#onRefresh"/>
                        </HBox>
                        <TableView fx:id="alertTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTimestamp"   text="Time"/>
                                <TableColumn fx:id="colSeverity"    text="Severity"/>
                                <TableColumn fx:id="colThreatType"  text="Threat"/>
                                <TableColumn fx:id="colSourceIp"    text="Source IP"/>
                                <TableColumn fx:id="colSourceMac"   text="MAC"/>
                                <TableColumn fx:id="colDestIp"      text="Dest IP"/>
                                <TableColumn fx:id="colProtocol"    text="Protocol"/>
                                <TableColumn fx:id="colRequestType" text="Request"/>
                                <TableColumn fx:id="colPackets"     text="Packets"/>
                                <TableColumn fx:id="colDetails"     text="Details"/>
                                <TableColumn fx:id="colOccurrences" text="Occurrences" prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- WHITELIST TAB -->
                <Tab text="Whitelist">
                    <VBox spacing="10" style="-fx-padding:10;">

                        <HBox spacing="10">
                            <TextField fx:id="tfFilterWlIp"
                                       promptText="Filter IP / MAC / Label"/>
                        </HBox>

                        <!-- Trusted Devices + Trusted Networks + Flagged IPs share the full page -->
                        <SplitPane orientation="VERTICAL"
                                   VBox.vgrow="ALWAYS"
                                   dividerPositions="0.34, 0.67">

                            <!-- SECTION 1: TRUSTED DEVICES -->
                            <VBox spacing="6" style="-fx-padding:6;">
                                <Label text="My Whitelist — Trusted Devices"
                                       style="-fx-font-weight:bold;"/>
                                <TableView fx:id="myWhitelistTable"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMyWlIp"
                                                     text="IP"/>
                                        <TableColumn fx:id="colMyWlMac"
                                                     text="MAC"/>
                                        <TableColumn fx:id="colMyWlLabel"
                                                     text="Label"/>
                                        <TableColumn fx:id="colMyWlAddedAt"
                                                     text="Added At"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="8">
                                    <TextField fx:id="tfNewMyWlIp"
                                               promptText="IP"/>
                                    <TextField fx:id="tfNewMyWlMac"
                                               promptText="MAC"/>
                                    <TextField fx:id="tfNewMyWlLabel"
                                               promptText="Label (e.g. Router)"/>
                                    <Button text="Add"
                                            onAction="#onAddMyWhitelist"/>
                                    <Button text="Delete Selected"
                                            onAction="#onDeleteMyWhitelist"/>
                                </HBox>
                            </VBox>

                            <!-- SECTION 2: TRUSTED NETWORKS (provider CIDR ranges) -->
                            <VBox spacing="6" style="-fx-padding:6;">
                                <Label text="Trusted Networks — Provider CIDR Ranges (Cloudflare / AWS / Google / Azure)"
                                       style="-fx-font-weight:bold;"/>
                                <TableView fx:id="trustedNetworkTable"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTnCidr"
                                                     text="CIDR"
                                                     prefWidth="160"/>
                                        <TableColumn fx:id="colTnProvider"
                                                     text="Provider"
                                                     prefWidth="120"/>
                                        <TableColumn fx:id="colTnCategory"
                                                     text="Category"
                                                     prefWidth="100"/>
                                        <TableColumn fx:id="colTnEnabled"
                                                     text="Enabled"
                                                     prefWidth="80"/>
                                        <TableColumn fx:id="colTnSuppress"
                                                     text="Suppress Beaconing"
                                                     prefWidth="140"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <TextField fx:id="tfNewTnCidr"
                                               promptText="CIDR (e.g. 104.16.0.0/13)"/>
                                    <TextField fx:id="tfNewTnProvider"
                                               promptText="Provider (e.g. Cloudflare)"/>
                                    <TextField fx:id="tfNewTnCategory"
                                               promptText="Category (e.g. CDN)"/>
                                    <CheckBox fx:id="cbNewTnSuppressBeaconing"
                                              text="Suppress beaconing"/>
                                    <Button text="Add"
                                            onAction="#onAddTrustedNetwork"/>
                                    <Button text="Enable/Disable"
                                            onAction="#onToggleTrustedNetwork"/>
                                    <Button text="Sync Provider Feeds"
                                            onAction="#onSyncTrustedNetworks"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#3b82f6;"/>
                                    <Button text="Delete Selected"
                                            onAction="#onDeleteTrustedNetwork"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#ef4444;"/>
                                </HBox>
                            </VBox>

                            <!-- SECTION 3: FLAGGED IPs -->
                            <VBox spacing="6" style="-fx-padding:6;">
                                <HBox spacing="10">
                                    <Label fx:id="lblFlaggedCount"
                                           text="Flagged IPs — 0 pending"
                                           style="-fx-font-weight:bold;
                                                  -fx-text-fill:#f59e0b;"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <CheckBox fx:id="cbSelectAllFlagged"
                                              text="Select All"
                                              onAction="#onSelectAllFlagged"/>
                                </HBox>
                                <TableView fx:id="flaggedIpTable"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colFlagSel"
                                                     text="✓"
                                                     prefWidth="30"/>
                                        <TableColumn fx:id="colFlagIp"
                                                     text="IP"/>
                                        <TableColumn fx:id="colFlagMac"
                                                     text="MAC"/>
                                        <TableColumn fx:id="colFlagThreat"
                                                     text="Threats"/>
                                        <TableColumn fx:id="colFlagSeverity"
                                                     text="Severity"/>
                                        <TableColumn fx:id="colFlagProto"
                                                     text="Protocols"/>
                                        <TableColumn fx:id="colFlagHits"
                                                     text="Hits"/>
                                        <TableColumn fx:id="colFlagSeen"
                                                     text="Last Seen"/>
                                    </columns>
                                </TableView>
                                <HBox spacing="8">
                                    <Button text="Accept Selected"
                                            onAction="#onAcceptFlagged"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#22c55e;"/>
                                    <Button text="Remove Selected"
                                            onAction="#onRemoveFlagged"
                                            style="-fx-text-fill:white;
                                                   -fx-background-color:#ef4444;"/>
                                </HBox>
                            </VBox>

                        </SplitPane>

                    </VBox>
                </Tab>
                <!-- END Whitelist Tab -->

                <!-- CASES -->
<Tab text="Cases">
    <VBox spacing="10" style="-fx-padding:10;">

        <!-- Filters -->
        <HBox spacing="10">

            <TextField fx:id="tfCaseFilterStatus"
                       promptText="Status"/>

            <TextField fx:id="tfCaseFilterIp"
                       promptText="IP"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="🛡 Create Cases from Alerts"
                    onAction="#onOpenAlertGroups"
                    style="-fx-background-color:#1f6feb;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

        </HBox>

        <!-- Cases Table -->
        <TableView fx:id="casesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCaseNum"
                             text="Case #"/>
                <TableColumn fx:id="colCaseTitle"
                             text="Title"/>
                <TableColumn fx:id="colCaseStatus"
                             text="Status"/>
                <TableColumn fx:id="colCaseSeverity"
                             text="Severity"/>
                <TableColumn fx:id="colCaseSuspectIp"
                             text="IP"/>
                <TableColumn fx:id="colCaseSuspectMac"
                             text="MAC"/>
                <TableColumn fx:id="colCaseThreatType"
                             text="Threat"/>
                <TableColumn fx:id="colCaseAssignedTo"
                             text="Assigned"/>
                <TableColumn fx:id="colCaseOpenedAt"
                             text="Opened"/>
            </columns>
        </TableView>

        <!-- Manual Case Creation -->
        <HBox spacing="10">
            <TextField fx:id="tfNewCaseTitle"
                       promptText="Title"/>
            <TextField fx:id="tfNewCaseSuspectIp"
                       promptText="IP"/>
            <TextField fx:id="tfNewCaseSuspectMac"
                       promptText="MAC"/>
            <ComboBox fx:id="cbNewCaseSeverity"/>
            <Button text="Create Case"
                    onAction="#onCreateCase"/>
            <Button text="Close Case"
                    onAction="#onCloseCase"/>
        </HBox>

        <Label fx:id="lblCaseStatus"/>

    </VBox>
</Tab>

                <!-- SETTINGS -->
                <Tab text="Settings">
                    <VBox spacing="10" style="-fx-padding:10;">
                        <TextField     fx:id="tfBackendUrl"
                                       promptText="Backend URL"/>
                        <TextField     fx:id="tfUsername"
                                       promptText="Username"/>
                        <PasswordField fx:id="pfPassword"
                                       promptText="Password"/>
                        <Button text="Login" onAction="#onLogin"/>
                        <Label fx:id="lblLoginStatus"/>
                    </VBox>
                </Tab>

            </TabPane>

        </VBox>
    </center>

</BorderPane>